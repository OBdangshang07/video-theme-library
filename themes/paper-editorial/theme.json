{
  "id": "paper-editorial",
  "name": "宣纸编辑部",
  "version": "3.0.0",
  "description": "暖米白宣纸、墨黑骨架、朱砂批注与编辑部档案语言。适合测评、解释、对比、历史、科技与作品展示，不绑定成绩叙事。",
  "files": {
    "tokens": "tokens.css",
    "components": "components.css",
    "motions": "motions.js",
    "transitions": "transitions.js",
    "advancedTransitions": "advanced-transitions.js",
    "screeningDossier": "snippets/screening-dossier.html",
    "slateFlight": "snippets/slate-flight.html",
    "inkPlate": "tools/ink-plate.mjs",
    "inkForm": "ink-form.js",
    "inkFormFont": "fonts/source-han-serif-medium.otf",
    "materialUtils": "material-utils.js",
    "movableType": "movable-type.js",
    "rubbingReveal": "rubbing-reveal.js",
    "paperCutaway": "paper-cutaway.js"
  },
  "palette": {
    "paper": "#EFE5CE",
    "ink": "#20262C",
    "vermilion": "#B83B2F",
    "paperLight": "#F4EAD4",
    "muted": "#68645B",
    "rule": "#C9BDA5"
  },
  "type": {
    "display": "Source Han Serif SC, STSong, serif",
    "body": "Source Han Sans SC, Microsoft YaHei, sans-serif",
    "numeric": "JetBrains Mono, Cascadia Mono, monospace"
  },
  "contracts": {
    "restingState": "任何以 immediateRender:false 起手的 fromTo 揭示，都必须先把该元素的静止态写进 CSS（opacity:0 + visibility:hidden）。否则元素会先以自然可见态渲染，等补间开始时才跳回起点——表现为「先出现，再原地演一次」。",
    "noClipOnVideo": "媒体面（<video>）永远不要用 clip-path 揭示：Chrome 会停止合成被裁剪的 video 画面，补间期间素材变成空白纸。改用 window-surface，或把裁切加在外层容器上。",
    "windowAfterFlight": "引导页→作品页的固定时序：文字先飞（slate-flight），飞到位置之后作品窗才允许出场（window-surface / screening-unveil）。作品窗在整段飞行期间必须完全不可见。"
  },
  "safeArea": {
    "x": 92,
    "top": 72,
    "bottom": 72
  },
  "motionCharacter": [
    "decisive",
    "editorial",
    "restrained",
