{
  "id": "modern-minimal",
  "name": "现代秩序",
  "version": "2.0.0",
  "description": "暖灰白画布、炭黑信息骨架、钴蓝单点强调与瑞士网格。依靠比例、留白、对齐和精确运动建立现代感。适合产品发布、科技解释、品牌片、企业内容、界面展示、数据概览和作品集。",
  "files": {
    "tokens": "tokens.css",
    "components": "components.css",
    "motions": "motions.js",
    "transitions": "transitions.js",
    "advancedTransitions": "advanced-transitions.js"
  },
  "palette": {
    "background": "#F4F5F2",
    "surface": "#FFFFFF",
    "ink": "#111317",
    "muted": "#666C75",
    "line": "#D8DBE0",
    "accent": "#2455FF"
  },
  "type": {
    "display": "Montserrat, Microsoft YaHei, sans-serif",
    "body": "Helvetica Neue, Microsoft YaHei, sans-serif",
    "numeric": "IBM Plex Mono, Cascadia Mono, monospace"
  },
  "safeArea": { "x": 96, "top": 72, "bottom": 72 },
  "motionCharacter": ["precise", "grid-locked", "restrained", "directional"],
  "components": [
    "modern-title", "grid-header", "surface-panel", "number-focus",
    "metric-row", "split-compare", "ranked-table", "process-line",
    "quote-block", "media-window", "status-pill", "verdict-slab",
    "section-index", "footnote", "progress-line", "closing-lockup",
    "showcase-dossier"
  ],
  "motions": [
    "grid-reveal", "precision-rise", "number-roll", "rule-expand",
    "list-stagger", "mask-slide", "focus-snap", "soft-emphasis",
    "index-shift", "closing-compress", "grid-settle", "metric-sweep",
    "section-mark", "showcase-unveil"
  ],
  "transitions": [
    "split-slide", "axis-rise", "clean-cross", "frame-pull",
    "blue-line-cut", "grid-shift", "panel-lock", "section-index-swap",
    "aperture-box", "precision-zoom", "axis-fold", "dot-expand",
    "swiss-cross-cut", "grid-dissolve", "measure-cut", "panel-slide-over"
  ],
  "advancedTransitions": [
    "grid-warp-field", "cobalt-scan-sweep", "axis-mirror-split",
    "focus-rack-depth", "threshold-resolve"
  ]
}
